# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=marketplace
DATABASE_USER=marketplace_user
DATABASE_PASSWORD=marketplace_password
DATABASE_URL=postgresql+asyncpg://marketplace_user:marketplace_password@localhost:5432/marketplace

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Application Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=false
LOG_LEVEL=INFO

# Service Configuration
CATALOG_SERVICE_URL=http://catalog:8001
ORDERS_SERVICE_URL=http://orders:8002
USERS_SERVICE_URL=http://users:8003
AUTH_SERVICE_URL=http://auth:8004
REVIEWS_SERVICE_URL=http://reviews:8005
NOTIFICATIONS_SERVICE_URL=http://notifications:8006

# Monitoring Configuration
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
SENTRY_DSN=

# Security Configuration
CORS_ORIGINS=["*"]
ALLOWED_HOSTS=["*"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@marketplace.com

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=["jpg", "jpeg", "png", "gif", "pdf"]

# External Services
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_API_KEY=
SHIPPING_API_URL=
SHIPPING_API_KEY=

# Development Configuration
ENVIRONMENT=development
RELOAD=true
WORKERS=1 